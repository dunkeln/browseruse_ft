FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

WORKDIR /app
COPY src ./src
ENV PYTHONPATH=/app/src
RUN uv pip install --system --no-cache \
    eval-protocol==0.3.32 \
    fastapi==0.141.1 \
    fireworks-ai==1.2.6 \
    playwright==1.62.0 \
    uvicorn==0.52.1 \
    && playwright install --with-deps chromium

CMD ["sh", "-c", "exec uvicorn browseruse_ft.remote:app --host 0.0.0.0 --port ${PORT:-80}"]
